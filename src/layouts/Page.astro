---
import Base from "./Base.astro";
import { getLocaleFromUrl, localePath, type Locale } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  showNav?: boolean;
}

const { title, description, showNav = true } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const canonical = Astro.site
  ? new URL(`${Astro.url.pathname}${Astro.url.search}`, Astro.site).href
  : Astro.url.href;

const isHome = title === "Home";
const mobTitle = isHome ? "" : title.toUpperCase();
---

<Base
  title={title}
  description={description}
  locale={locale}
  canonical={canonical}
>
  <!-- Mobile header: hidden on desktop, visible on mobile -->
  <header class="mob-header" id="mob-header">
    <span class="mob-header__title">{mobTitle}</span>
    <button
      class="mob-burger"
      id="mob-burger"
      aria-label="Open navigation"
      type="button"
    >
      <svg
        width="28"
        height="22"
        viewBox="0 0 28 22"
        fill="none"
        aria-hidden="true"
      >
        <rect x="0" y="0" width="28" height="3" rx="1.5" fill="currentColor"
        ></rect>
        <rect x="0" y="9.5" width="28" height="3" rx="1.5" fill="currentColor"
        ></rect>
        <rect x="0" y="19" width="28" height="3" rx="1.5" fill="currentColor"
        ></rect>
      </svg>
    </button>
  </header>

  <!-- Full-screen hamburger nav overlay -->
  <div
    class="mob-nav"
    id="mob-nav"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <button
      class="mob-nav__close"
      id="mob-nav-close"
      aria-label="Close navigation"
      type="button"
    >
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M20.7 3.3a1 1 0 0 0-1.4 0L12 10.6 4.7 3.3a1 1 0 1 0-1.4 1.4L10.6 12l-7.3 7.3a1 1 0 1 0 1.4 1.4L12 13.4l7.3 7.3a1 1 0 1 0 1.4-1.4L13.4 12l7.3-7.3a1 1 0 0 0 0-1.4Z"
          fill="currentColor"></path>
      </svg>
    </button>

    <nav class="mob-nav__bands">
      <a
        class="mob-nav__band mob-nav__band--home"
        href={localePath("/", locale)}
        {...(isHome ? { "aria-current": "page" } : {})}
      >
        <span class={`mob-nav__label${isHome ? " is-active" : ""}`}>HOME</span>
      </a>
      <a
        class="mob-nav__band mob-nav__band--exp"
        href={localePath("/experience", locale)}
        {...(title === "Experience" ? { "aria-current": "page" } : {})}
      >
        <span
          class={`mob-nav__label${title === "Experience" ? " is-active" : ""}`}
          >EXPERIENCE</span
        >
      </a>
      <a
        class="mob-nav__band mob-nav__band--works"
        href={localePath("/works", locale)}
        {...(title === "Works" ? { "aria-current": "page" } : {})}
      >
        <span class={`mob-nav__label${title === "Works" ? " is-active" : ""}`}
          >WORKS</span
        >
      </a>
      <a
        class="mob-nav__band mob-nav__band--cv"
        href={localePath("/cv", locale)}
        {...(title === "Curriculum Vitae" || title === "CV" ? { "aria-current": "page" } : {})}
      >
        <span
          class={`mob-nav__label${title === "Curriculum Vitae" || title === "CV" ? " is-active" : ""}`}
          >CV</span
        >
      </a>
      <div class="mob-nav__band mob-nav__band--lang">
        <a
          class={`mob-nav__lang${locale === "en" ? " is-active" : ""}`}
          href={localePath("/", "en")}
          {...(locale === "en" ? { "aria-current": "true" } : {})}>→ English</a
        >
        <a
          class={`mob-nav__lang${locale === "de" ? " is-active" : ""}`}
          href={localePath("/", "de")}
          {...(locale === "de" ? { "aria-current": "true" } : {})}>Deutsch</a
        >
        <a
          class={`mob-nav__lang${locale === "hu" ? " is-active" : ""}`}
          href={localePath("/", "hu")}
          {...(locale === "hu" ? { "aria-current": "true" } : {})}>Magyar</a
        >
      </div>
    </nav>
  </div>

  <!-- Desktop close button (hidden on mobile) -->
  {
    showNav && (
      <a
        class="pageCloseBtn"
        href={localePath("/", locale)}
        aria-label="Back to home"
      >
        <svg
          width="50"
          height="50"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20.7457 3.32851C20.3552 2.93798 19.722 2.93798 19.3315 3.32851L12.0371 10.6229L4.74275 3.32851C4.35223 2.93798 3.71906 2.93798 3.32854 3.32851C2.93801 3.71903 2.93801 4.3522 3.32854 4.74272L10.6229 12.0371L3.32856 19.3314C2.93803 19.722 2.93803 20.3551 3.32856 20.7457C3.71908 21.1362 4.35225 21.1362 4.74277 20.7457L12.0371 13.4513L19.3315 20.7457C19.722 21.1362 20.3552 21.1362 20.7457 20.7457C21.1362 20.3551 21.1362 19.722 20.7457 19.3315L13.4513 12.0371L20.7457 4.74272C21.1362 4.3522 21.1362 3.71903 20.7457 3.32851Z"
            fill="currentColor"
            stroke="var(--scrollbar-bg, transparent)"
            stroke-width="2.5"
            stroke-linejoin="round"
            style="paint-order: stroke fill"
          />
        </svg>
      </a>
    )
  }

  <main id="main-content">
    <slot />
  </main>

  <footer class={`site-footer${isHome ? " site-footer--home" : ""}`}>
    <div class="footer__inner">
      <!-- Navigation links -->
      <nav class="footer__nav" aria-label="Footer navigation">
        <a
          class={`footer__nav-link${title === "Experience" ? " is-active" : ""}`}
          href={localePath("/experience", locale)}
          {...(title === "Experience" ? { "aria-current": "page" } : {})}>Experience</a
        >
        <span class="footer__sep" aria-hidden="true">·</span>
        <a
          class={`footer__nav-link${title === "Works" ? " is-active" : ""}`}
          href={localePath("/works", locale)}
          {...(title === "Works" ? { "aria-current": "page" } : {})}>Works</a
        >
        <span class="footer__sep" aria-hidden="true">·</span>
        <a
          class={`footer__nav-link${title === "Curriculum Vitae" || title === "CV" ? " is-active" : ""}`}
          href={localePath("/cv", locale)}
          {...(title === "Curriculum Vitae" || title === "CV" ? { "aria-current": "page" } : {})}>CV</a
        >
      </nav>

      <!-- Contact info -->
      <address class="footer__contact">
        <a
          class="footer__contact-link"
          href="mailto:molnar.eszter.zsuzsa@gmail.com"
        >
          mol.eszter04@gmail.com
        </a>
        <span class="footer__sep" aria-hidden="true">·</span>
        <a class="footer__contact-link" href="tel:+43123456789">
          +36 30 911 7060
        </a>
        <span class="footer__sep" aria-hidden="true">·</span>
        <a
          class="footer__contact-link"
          href="https://www.linkedin.com/in/esztermolnar0420"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
      </address>

      <!-- Copyright & legal -->
      <p class="footer__legal">
        © {new Date().getFullYear()} Eszter Molnár · All rights reserved ·
        <span>Built with Astro</span>
      </p>
    </div>
  </footer>

  <script>
    document.addEventListener("astro:page-load", () => {
      const burger = document.getElementById("mob-burger");
      const nav = document.getElementById("mob-nav");
      const closeBtn = document.getElementById("mob-nav-close");

      const openNav = () => {
        nav?.classList.add("is-open");
        nav?.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        // Move focus into dialog so keyboard/screen reader users are inside it
        closeBtn?.focus();
      };

      const closeNav = () => {
        nav?.classList.remove("is-open");
        nav?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        // Return focus to the trigger that opened the dialog
        burger?.focus();
      };

      burger?.addEventListener("click", openNav);
      closeBtn?.addEventListener("click", closeNav);

      // Close when clicking outside the nav bands (on the close button area)
      nav?.addEventListener("click", (e) => {
        if (e.target === nav) closeNav();
      });
    });
  </script>

  <style>
    /* ── Desktop close button ─────────────────────────── */
    .pageCloseBtn {
      position: fixed;
      top: 1.75rem;
      right: 1.75rem;
      z-index: 50;
      color: var(--color-ink);
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: transform 0.2s ease;
    }
    .pageCloseBtn:hover {
      transform: scale(1.1);
    }

    /* ── Mobile header ───────────────────────────────── */
    .mob-header {
      display: none; /* hidden on desktop */
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1rem 1.4rem;
      align-items: center;
      justify-content: space-between;
      background: var(--scrollbar-bg, var(--color-surface));
      color: var(--mob-header-ink, var(--color-ink));
    }
    .mob-header__title {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }
    /* Used by home page JS to fade name in/out on scroll */
    .mob-header__title.is-hidden {
      opacity: 0;
      transform: translateY(-6px);
    }
    .mob-header__title.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .mob-burger {
      background: none;
      border: none;
      cursor: pointer;
      color: inherit;
      padding: 0.2rem;
      display: grid;
      place-items: center;
    }

    /* ── Hamburger nav overlay ───────────────────────── */
    .mob-nav {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition:
        transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s linear 0.35s;
      visibility: hidden;
    }
    .mob-nav.is-open {
      transform: translateX(0);
      visibility: visible;
      transition:
        transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s linear 0s;
    }
    .mob-nav__close {
      position: absolute;
      top: 1.1rem;
      right: 1.4rem;
      z-index: 201;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--color-ink);
      padding: 0.3rem;
      display: grid;
      place-items: center;
    }
    .mob-nav__bands {
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow-y: auto;
      /* hide scrollbar cross-browser */
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }
    .mob-nav__bands::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }
    .mob-nav__band {
      flex: 1;
      min-height: 5rem; /* never collapse thinner than this */
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      padding: 0 2rem 1.2rem;
      text-decoration: none;
      color: var(--color-ink);
    }
    .mob-nav__band--home {
      background: var(--color-bg-contact);
    }
    .mob-nav__band--exp {
      background: var(--color-bg-experience);
    }
    .mob-nav__band--works {
      background: var(--color-bg-works);
    }
    .mob-nav__band--cv {
      background: var(--color-bg-cv);
    }
    .mob-nav__band--lang {
      background: var(--color-bg-home);
      color: var(--color-white);
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      gap: 0.6rem;
    }
    .mob-nav__label {
      font-size: 1.9rem;
      font-weight: 400;
      letter-spacing: 0.04em;
    }
    .mob-nav__label.is-active {
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 6px;
    }
    .mob-nav__lang {
      font-size: 1.15rem;
      color: var(--color-white);
      text-decoration: none;
    }
    .mob-nav__lang.is-active {
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* ── Show mobile header on small screens ─────────── */
    @media (max-width: 768px) {
      .mob-header {
        display: flex;
      }
      .pageCloseBtn {
        display: none;
      }
      h1 {
        display: none;
      }
    }

    /* ── Landscape phone: lang links in one row ──────── */
    @media (orientation: landscape) and (max-height: 768px) {
      /* Push all labels away from the X close button (right: ~3.5rem total) */
      .mob-nav__band {
        padding-right: 4rem;
      }
      .mob-nav__band--lang {
        flex-direction: row;
        justify-content: flex-end;
        align-items: center;
        gap: 1.2rem;
        padding: 0 4rem;
      }
    }

    /* ── Site footer ─────────────────────────────────── */
    .site-footer {
      background: var(--scrollbar-bg, var(--color-surface));
      color: var(--color-ink);
      /* border-top: 1px solid rgba(34, 34, 59, 0.06); */
      box-shadow: 0 -8px 32px rgba(34, 34, 59, 0.12);
    }

    .footer__inner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 2.5rem 3.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
    }

    /* Nav links row */
    .footer__nav {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer__nav-link {
      text-decoration: none;
      color: inherit;
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    .footer__nav-link:hover,
    .footer__nav-link.is-active {
      opacity: 1;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .footer__sep {
      font-size: 0.85rem;
    }

    /* Contact row */
    .footer__contact {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
      font-style: normal;
    }

    .footer__contact-link {
      text-decoration: none;
      color: inherit;
      font-size: 0.95rem;
      transition: opacity 0.2s ease;
    }

    .footer__contact-link:hover {
      opacity: 1;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Legal line */
    .footer__legal {
      font-size: 0.82rem;
      margin: 0;
    }

    /* Home page: hide footer on desktop, show on mobile with contact green */
    .site-footer--home {
      display: none;
    }

    @media (max-width: 768px) {
      /* Flat line instead of glow on mobile */
      .site-footer {
        box-shadow: none;
        border-top: 1px solid rgba(34, 34, 59, 0.2);
      }

      .site-footer--home {
        display: block;
        background: var(--color-bg-contact);
        color: var(--color-ink);
        border-top: 1px solid rgba(34, 34, 59, 0.2);
      }

      .footer__inner {
        padding: 2rem 1.5rem;
        gap: 0.85rem;
      }
    }
  </style>
</Base>
