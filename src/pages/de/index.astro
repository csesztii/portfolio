---
import Page from "../../layouts/Page.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getLocaleFromUrl, localePath, publicAsset } from "../../i18n/utils";

const title = "Home";
const description = "Portfolio – Startseite";

const locale = getLocaleFromUrl(Astro.url);
---

<Page title={title} description={description} showNav={false}>
  <section class="page page--home">
    <div class="home">
      <section class="home__left">
        <div class="leftInner" id="left-content">
          <img
            class="avatar reveal"
            src={publicAsset("media/profile.jpeg")}
            alt="Eszter Molnár"
          />
          <h1 class="name reveal">Eszter Molnár</h1>
          <p class="intro reveal">
            Ich bin Informatikerin und absolviere derzeit einen Master in KI,
            der auf meinem Bachelor in Informatik aufbaut. Meine technische
            Erfahrung ist breit gefächert: Ich bin versiert in Software
            Engineering, KI, Datenwissenschaft und Webentwicklung. Was meine
            Arbeit auszeichnet, ist mein kreativer Ansatz. Ich konzentriere mich
            nicht nur auf die technische Seite, sondern genieße es, einzigartige
            Lösungen zu finden und über die Nutzererfahrung nachzudenken – was
            zu Produkten führt, die sowohl effektiv als auch benutzerfreundlich
            sind.
          </p>
          <a class="readcv reveal" href={localePath("/cv", locale)}
            >Lebenslauf lesen →</a
          >

          <div class="globeWrap reveal">
            <div class="globe" aria-hidden="true">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none">
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  stroke="currentColor"
                  stroke-width="1.8"></circle>
                <path
                  d="M3.5 12h17M12 3c2.5 2.7 4 5.9 4 9s-1.5 6.3-4 9c-2.5-2.7-4-5.9-4-9s1.5-6.3 4-9Z"
                  stroke="currentColor"
                  stroke-width="1.2"></path>
              </svg>
            </div>

            <div class="lang" aria-label="Sprache">
              <a class="lang__item" href={localePath("/", "en")}>English</a>
              <a
                class="lang__item lang__item--active"
                href={localePath("/", "de")}
                aria-current="true">→ Deutsch</a
              >
              <a class="lang__item" href={localePath("/", "hu")}>Magyar</a>
            </div>
          </div>

          <button class="contactBtn reveal" id="contact-open" type="button"
            >KONTAKT</button
          >
        </div>

        <div class="contactOverlay" id="contact-slot">
          <button
            class="closeBtn"
            id="contact-close"
            type="button"
            aria-label="Kontaktformular schließen"
          >
            <svg
              width="50"
              height="50"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M20.7457 3.32851C20.3552 2.93798 19.722 2.93798 19.3315 3.32851L12.0371 10.6229L4.74275 3.32851C4.35223 2.93798 3.71906 2.93798 3.32854 3.32851C2.93801 3.71903 2.93801 4.3522 3.32854 4.74272L10.6229 12.0371L3.32856 19.3314C2.93803 19.722 2.93803 20.3551 3.32856 20.7457C3.71908 21.1362 4.35225 21.1362 4.74277 20.7457L12.0371 13.4513L19.3315 20.7457C19.722 21.1362 20.3552 21.1362 20.7457 20.7457C21.1362 20.3551 21.1362 19.722 20.7457 19.3315L13.4513 12.0371L20.7457 4.74272C21.1362 4.3522 21.1362 3.71903 20.7457 3.32851Z"
                fill="currentColor"></path>
            </svg>
          </button>
          <ContactForm
            title="KONTAKT"
            labelFirstName="Vorname"
            labelLastName="Nachname"
            labelEmail="E-Mail-Adresse"
            labelMessage="Nachricht"
            labelSend="SENDEN"
            labelCta="Füllen Sie das Formular aus, um mich zu kontaktieren!"
          />
        </div>
      </section>

      <section class="home__right">
        <div class="navBtns" id="home-nav">
          <a
            class="bigBtn bigBtn--exp reveal"
            href={localePath("/experience", locale)}>ERFAHRUNG</a
          >
          <a
            class="bigBtn bigBtn--works reveal"
            href={localePath("/works", locale)}>PROJEKTE</a
          >
          <a class="bigBtn bigBtn--cv reveal" href={localePath("/cv", locale)}
            >LEBENSLAUF</a
          >
        </div>
      </section>
    </div>
  </section>

  <script>
    document.addEventListener("astro:page-load", () => {
      // ── Float-up entrance animation ──────────────────────────────────
      const leftItems = document.querySelectorAll(".home__left .reveal");
      const rightItems = document.querySelectorAll(".home__right .reveal");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              observer.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const inLeft = !!el.closest(".home__left");
              const list = inLeft ? leftItems : rightItems;
              const baseDelay = inLeft ? 0 : 120;
              const index = Array.from(list).indexOf(el);
              el.style.animationDelay = `${baseDelay + index * 80}ms`;
              el.classList.add("is-visible");
            }
          });
        },
        { threshold: 0.01 },
      );

      leftItems.forEach((el) => observer.observe(el));
      rightItems.forEach((el) => observer.observe(el));
      // ────────────────────────────────────────────────────────────────

      // ── Show name in mob-header when .name scrolls out of view ───────
      const nameEl = document.querySelector(".name") as HTMLElement | null;
      const mobTitle = document.querySelector(".mob-header__title") as HTMLElement | null;

      if (nameEl && mobTitle) {
        mobTitle.classList.add("is-hidden");

        const nameObserver = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) {
              mobTitle.textContent = "Eszter Molnár";
              mobTitle.classList.remove("is-hidden");
              mobTitle.classList.add("is-visible");
            } else {
              mobTitle.classList.remove("is-visible");
              mobTitle.classList.add("is-hidden");
              mobTitle.addEventListener(
                "transitionend",
                () => {
                  if (!mobTitle.classList.contains("is-visible")) {
                    mobTitle.textContent = "";
                  }
                },
                { once: true },
              );
            }
          },
          { threshold: 0 },
        );
        nameObserver.observe(nameEl);
      }
      // ────────────────────────────────────────────────────────────────

      const open = document.getElementById("contact-open");
      const slot = document.getElementById("contact-slot");
      const close = document.getElementById("contact-close");
      const nav = document.getElementById("home-nav");
      const homeSection = document.querySelector(".home__left");

      function closeContact() {
        if (slot) slot.classList.remove("is-open");
        if (nav) nav.hidden = false;
        document.documentElement.style.overflow = "";
        open?.focus();
      }

      if (open && slot) {
        open.addEventListener("click", (e) => {
          e.stopPropagation();
          slot.classList.add("is-open");
          if (nav) nav.hidden = true;
          document.documentElement.style.overflow = "hidden";
          close?.focus();
        });
      }
      if (close && slot) {
        close.addEventListener("click", closeContact);
      }

      if (homeSection) {
        homeSection.addEventListener("click", (e) => {
          if (
            slot &&
            slot.classList.contains("is-open") &&
            !slot.contains(e.target as Node)
          ) {
            closeContact();
          }
        });
      }
    });
  </script>

  <style is:global>
    :root {
      --scrollbar-bg: var(--color-bg-home);
      --mob-header-ink: var(--color-white);
    }
  </style>
  <style>
    :global(html) {
      overflow-y: scroll;
      scrollbar-width: none;
    }
    :global(html)::-webkit-scrollbar {
      display: none;
    }
    .page--home {
      background: var(--color-bg-home);
      color: var(--color-white);
      min-height: 100vh;
      display: grid;
    }
    .home {
      width: 100%;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 50% 50%;
    }
    .home__left {
      position: relative;
      padding: 5rem 2.5rem;
      display: grid;
      align-content: start;
      overflow: hidden;
    }
    @media (min-width: 1440px) {
      .home__left {
        padding-left: 5rem;
        padding-top: 4rem;
      }
    }
    .leftInner {
      display: grid;
      align-content: start;
      justify-content: center;
      max-width: 80%;
      min-width: 70%;
      gap: 1rem;
    }
    .avatar {
      width: 40%;
      object-fit: cover;
      margin: auto;
      border-radius: 10px;
      border: 2px solid rgb(255, 255, 255);
      background: rgba(255, 255, 255, 0.08);
      box-shadow: 0 0 16px rgba(255, 255, 255, 0.26);
    }
    .name {
      margin: 0;
      font-size: 3.5rem;
      letter-spacing: -0.02em;
      font-weight: 500;
      text-align: center;
    }
    .intro {
      margin: 0;
      opacity: 0.92;
      font-size: 1rem;
      text-align: justify;
      font-weight: 300;
    }
    .readcv {
      color: inherit;
      width: max-content;
      opacity: 0.9;
      text-decoration: underline;
      text-underline-offset: 6px;
      font-size: 1.2rem;
    }

    .globeWrap {
      position: absolute;
      top: 2.25rem;
      left: 2.25rem;
      width: max-content;
    }
    .globe {
      width: max-content;
      opacity: 0.95;
      cursor: default;
      transition:
        transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.4s ease;
    }
    .globeWrap:hover .globe {
      transform: rotate(360deg) scale(0);
      opacity: 0;
    }
    .lang {
      position: absolute;
      top: 0px;
      right: -120px;
      background: var(--color-white);
      color: var(--color-ink);
      padding: 1.25rem 2.5rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-15px);
      transition:
        opacity 0.3s ease,
        visibility 0.3s ease,
        transform 0.3s ease;
      gap: 0.5rem;
      text-align: center;
      font-size: 1.05rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
      min-width: 9.375rem;
      max-width: 18.75rem;
      display: grid;
    }
    .lang__item {
      text-decoration: none;
      color: inherit;
      white-space: nowrap;
    }
    .lang__item--active {
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 6px;
    }
    .globeWrap:hover .lang {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .contactBtn {
      margin-top: 1.25rem;
      width: max-content;
      padding: 0.6rem 2.2rem;
      border-radius: 6px;
      border: 0;
      background: var(--color-bg-contact);
      color: var(--color-ink);
      font-weight: 500;
      font-size: 1.2rem;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: transform 0.3s ease;
      will-change: transform;
    }
    .contactBtn:hover {
      transform: scale(1.05);
    }

    .contactOverlay {
      position: absolute;
      inset: 0;
      z-index: 5;
      overflow: auto;
      --scrollbar-bg: var(--color-bg-contact);
      opacity: 0;
      visibility: hidden;
      transform: translateY(100px) scale(0.9) translateZ(0);
      transition:
        opacity 0.3s ease,
        visibility 0.3s ease,
        transform 0.3s ease;
      will-change: transform, opacity, visibility;
    }
    .contactOverlay.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1) translateZ(0);
      transition:
        opacity 0.25s ease,
        visibility 0.25s ease,
        transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .closeBtn {
      position: absolute;
      top: 1.75rem;
      right: 1.75rem;
      z-index: 6;
      background: transparent;
      border: none;
      color: var(--color-ink);
      cursor: pointer;
      display: grid;
      place-items: center;
      padding: 0;
    }

    .home__right {
      padding: 2rem 2.5rem;
      display: flex;
      flex-direction: column;
    }
    .navBtns {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      gap: 0;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .reveal {
      opacity: 0;
    }
    .reveal.is-visible {
      animation: fadeIn 0.6s ease both;
    }

    .bigBtn {
      height: 25%;
      display: grid;
      place-items: center;
      text-decoration: none;
      color: inherit;
      border-radius: 15px;
      border: 2px solid currentColor;
      font-size: 3.5rem;
      font-weight: 300;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.02);
      transition:
        box-shadow 0.3s ease,
        transform 0.3s ease;
      will-change: box-shadow, transform;
      transform: translateZ(0);
    }
    .bigBtn:hover {
      transform: translateY(-2px) translateZ(0);
    }
    .bigBtn--exp {
      color: var(--color-bg-experience);
      box-shadow: 0 0 16px rgba(189, 178, 255, 0.35);
    }
    .bigBtn--exp:hover {
      box-shadow: 0 0 40px rgba(189, 178, 255, 0.8);
    }
    .bigBtn--works {
      color: #90e0ef;
      box-shadow: 0 0 16px rgba(144, 224, 239, 0.35);
    }
    .bigBtn--works:hover {
      box-shadow: 0 0 40px rgba(144, 224, 239, 0.8);
    }
    .bigBtn--cv {
      color: #ffd6a5;
      box-shadow: 0 0 16px rgba(255, 214, 165, 0.35);
    }
    .bigBtn--cv:hover {
      box-shadow: 0 0 40px rgba(255, 214, 165, 0.8);
    }

    @media (max-width: 768px) {
      .home {
        grid-template-columns: 1fr;
        min-height: unset;
      }
      .home__left {
        padding: 1.5rem 0rem 0rem;
        overflow: visible;
        min-height: unset;
      }
      .leftInner {
        max-width: 100%;
        min-width: unset;
        width: 100%;
        align-items: center;
        padding: 0rem 2.7rem 2rem;
      }
      .avatar {
        width: 55%;
        max-width: 220px;
      }
      .name {
        font-size: 2.4rem;
      }
      .intro {
        font-size: 1rem;
      }
      .globeWrap {
        display: none;
      }
      .contactBtn {
        display: none;
      }
      .home__right {
        display: none;
      }
      .contactOverlay {
        position: static;
        opacity: 1;
        visibility: visible;
        transform: none;
        transition: none;
        will-change: auto;
        overflow: visible;
      }
      .closeBtn {
        display: none;
      }
    }

    @media (min-width: 769px) and (max-width: 1100px) {
      .home__right {
        padding: 1.5rem 1.25rem;
        margin-top: 5rem;
      }
      .bigBtn {
        font-size: clamp(2.5rem, 3.2vw, 2.8rem);
        border-radius: 10px;
        letter-spacing: 0.04em;
        height: 20%;
        min-height: 20%;
      }
      .navBtns {
        gap: 4rem;
        justify-content: flex-start;
      }
      .leftInner {
        max-width: 90%;
      }
      .name {
        font-size: clamp(2.5rem, 3.2vw, 2.8rem);
      }
    }
  </style>
</Page>
