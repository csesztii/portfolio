---
import { publicAsset } from "../i18n/utils";

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image: string;
  buttonText?: string;
  url?: string;
  repo?: string;
  featured?: boolean;
}

const {
  title,
  subtitle,
  description,
  image,
  buttonText = "View",
  url,
  repo,
  featured = false,
} = Astro.props;

const normalizedImage =
  image.startsWith("http://") ||
  image.startsWith("https://") ||
  image.startsWith("data:")
    ? image
    : publicAsset(image.replace(/^\/+/, ""));

const href = url ?? repo ?? "#";
---

<article class={`card ${featured ? "card--featured" : ""}`}>
  <div class="card__inner">
    <div class="card__header">
      <h3 class="card__title">{title}</h3>
      {subtitle && <p class="card__subtitle">{subtitle}</p>}
    </div>

    <div class="card__body">
      <div class="card__media">
        <img
          class="card__img"
          src={normalizedImage}
          alt={`Screenshot of ${title}`}
          loading="eager"
          decoding="async"
          data-card-img
        />
      </div>
      <p class="card__desc">{description}</p>
    </div>

    <div class="card__actions">
      {
        url && (
          <a
            class="card__cta"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${buttonText} — ${title}`}
          >
            {buttonText}
          </a>
        )
      }
      {
        repo && (
          <a
            class="card__cta"
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`See code — ${title}`}
          >
            SEE CODE
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    border-radius: 10px;
    /* border: 2px solid var(--color-ink); */
    border: 2px solid #62b5c4;
    background: transparent;
    color: var(--color-ink);
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
    will-change: transform, box-shadow;
    transform: translateZ(0);
  }

  .card:hover {
    border: 2px solid var(--color-ink);
    box-shadow: 0 8px 28px rgba(34, 34, 59, 0.22);
    transform: translateY(-4px) translateZ(0);
  }

  .card--featured {
    grid-column: span 2;
    background: var(--color-ink);
    color: var(--color-bg-works);
    border-color: var(--color-ink);
  }
  .card--featured:hover {
    box-shadow: 0 8px 32px rgba(34, 34, 59, 0.35);
    transform: translateY(-4px) translateZ(0);
  }
  .card__inner {
    height: 100%;
    padding: 2rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card--featured .card__inner {
    gap: 1.5rem;
  }

  .card__header {
    display: grid;
    gap: 0.25rem;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex-grow: 1;
  }
  .card--featured .card__body {
    flex-direction: row-reverse;
    align-items: flex-start;
  }

  /* Skeleton shimmer while image loads */
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
  .card__media {
    /* Always crop to 16:9 regardless of card width or screen size */
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    background: linear-gradient(
      90deg,
      rgba(34, 34, 59, 0.08) 25%,
      rgba(34, 34, 59, 0.16) 50%,
      rgba(34, 34, 59, 0.08) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.4s ease infinite;
  }
  /* Stop shimmer once img has loaded (class toggled by script) */
  .card__media.is-loaded {
    background: transparent;
    animation: none;
  }
  .card--featured .card__media {
    flex: 0 0 45%;
    max-width: 400px;
    /* Keep 16:9 on featured card too — override with unset so aspect-ratio still applies */
    aspect-ratio: 16 / 9;
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: center;
    /* opacity managed by JS — no CSS default so images are always visible without JS */
    transition: opacity 0.4s ease;
  }
  .card__img.is-loaded {
    opacity: 1;
  }
  .card--featured .card__img {
    object-position: center;
  }

  /* ════════ MEDIUM: 769px – 1100px ════════ */
  @media (min-width: 769px) and (max-width: 1100px) {
    .card--featured {
      grid-column: span 1;
    }
    .card--featured .card__body {
      flex-direction: column;
    }
    .card--featured .card__media {
      flex: unset;
      max-width: 100%;
      /* aspect-ratio handles height automatically */
    }
  }

  @media (max-width: 768px) {
    .card,
    .card:hover {
      border: none;
      border-radius: 0;
      border-bottom: 1px solid var(--color-ink);
      padding-bottom: 3rem;
      margin-bottom: 0;
    }
    .card:hover,
    .card--featured:hover {
      box-shadow: none;
      transform: translateZ(0); /* no lift on touch */
      transition: none;
    }
    .card--featured {
      grid-column: span 1;
    }
    .card--featured .card__body {
      flex-direction: column;
    }
    .card--featured .card__media {
      flex: unset;
      max-width: 100%;
      /* aspect-ratio handles height automatically */
    }
    .card__img {
      /* Full-width 16:9 crop on mobile too */
      max-width: 100%;
      margin: auto;
      object-fit: cover;
    }
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.1;
    font-size: 2.2rem;
  }

  .card__subtitle {
    margin: 0;
    font-size: 1.5rem;
    color: inherit;
    line-height: 1.3;
    font-weight: 300;
  }
  .card__desc {
    margin: 0;
    color: inherit;
    min-height: 2.2em;
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .card--featured .card__desc {
    flex: 1;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: auto;
    padding-top: 1rem;
  }
  .card__cta {
    border-radius: 6px;
    padding: 0.6rem 2rem;
    border: 2px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg-works);
    text-decoration: none;
    letter-spacing: 0.02em;
    font-weight: 600;
    text-align: center;
    text-transform: uppercase;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  .card__cta:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }
  .card--featured .card__cta {
    border-color: var(--color-bg-works);
    background: var(--color-bg-works);
    color: var(--color-ink);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("img[data-card-img]").forEach((img) => {
      const el = img as HTMLImageElement;
      const media = el.closest(".card__media") as HTMLElement | null;

      const reveal = () => {
        // Use explicit inline style so it overrides the earlier inline opacity:0
        el.style.opacity = "1";
        el.classList.add("is-loaded");
        media?.classList.add("is-loaded");
      };

      const revealAfterDecode = () => {
        // Use decode() to ensure pixels are truly painted before removing shimmer
        if (typeof el.decode === "function") {
          el.decode().then(reveal).catch(reveal);
        } else {
          reveal();
        }
      };

      if (el.complete && el.naturalWidth > 0) {
        // Already loaded (e.g. cached) — reveal immediately
        revealAfterDecode();
      } else {
        // Hide NOW (JS is ready) then watch for load — no gap between paint and JS
        el.style.opacity = "0";
        el.addEventListener("load", revealAfterDecode, { once: true });
        el.addEventListener(
          "error",
          () => {
            // On error: remove shimmer but keep image slot visible
            el.style.opacity = "1";
            media?.classList.add("is-loaded");
          },
          { once: true },
        );
      }
    });
  });
</script>
